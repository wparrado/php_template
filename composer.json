{
    "name": "app/php-hexagonal-template",
    "description": "PHP Laravel 11 — Hexagonal Architecture Template",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "ramsey/uuid": "^4.7",
        "zircote/swagger-php": "^6.1"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Domain\\": "src/Domain/",
            "Application\\": "src/Application/",
            "Infrastructure\\": "src/Infrastructure/",
            "Presentation\\": "src/Presentation/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "stan": "vendor/bin/phpstan analyse --memory-limit=512M --level=9 src",
        "test": "vendor/bin/pest",
        "test:unit": "vendor/bin/pest --group=unit",
        "test:integration": "vendor/bin/pest --group=integration",
        "test:arch": "vendor/bin/pest --group=architecture",
        "generate:openapi": "php artisan openapi:generate"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.31"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
